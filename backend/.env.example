# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Leave empty to automatically use embedded in-memory MongoDB for instant zero-config setup,
# or provide a local/Atlas connection string: mongodb://localhost:27017/expenseiq
MONGO_URI=

# Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRE=30d

# Machine Learning Service URL
ML_SERVICE_URL=http://localhost:8000

# AI Provider Configuration
# Supported providers: local (default rule-based fallback), gemini, openai
AI_PROVIDER=local
AI_API_KEY=

# Client Application URL for CORS
CLIENT_URL=http://localhost:5173
